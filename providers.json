{
  "export_targets": {
    "anthropic": {
      "adapter_files": [
        "adapters/anthropic/CLAUDE.md"
      ],
      "description": "Provider-neutral bundle for Claude-style agents that can consume CLAUDE.md, slash commands, and Markdown skills."
    },
    "continue": {
      "adapter_files": [
        "adapters/continue/.continue/rules/agtmls.md"
      ],
      "description": "Provider-neutral Markdown bundle for Continue-style assistant contexts."
    },
    "cursor": {
      "adapter_files": [
        "adapters/cursor/.cursor/rules/agtmls.mdc"
      ],
      "description": "Provider-neutral Markdown bundle for Cursor project-rule adaptation."
    },
    "deepseek": {
      "adapter_files": [
        "adapters/deepseek/AGENTS.md"
      ],
      "description": "Provider-neutral Markdown bundle for DeepSeek-based coding agents."
    },
    "generic": {
      "adapter_files": [
        "ADAPTERS.md"
      ],
      "description": "Provider-neutral bundle containing SKILL.md files, references, commands, prompts, index, profiles, and provider metadata."
    },
    "github-copilot": {
      "adapter_files": [
        "adapters/github-copilot/.github/copilot-instructions.md"
      ],
      "description": "Provider-neutral Markdown bundle suitable for Copilot-adjacent repository instruction workflows."
    },
    "google-gemini": {
      "adapter_files": [
        "adapters/google-gemini/GEMINI.md"
      ],
      "description": "Provider-neutral Markdown bundle for Gemini-style agents or custom Gemini CLI integrations."
    },
    "mistral": {
      "adapter_files": [
        "adapters/mistral/AGENTS.md"
      ],
      "description": "Provider-neutral Markdown bundle for Mistral-based agent runtimes."
    },
    "ollama": {
      "adapter_files": [
        "adapters/ollama/Modelfile.instructions.md"
      ],
      "description": "Provider-neutral local-model bundle for Ollama-backed agent runtimes."
    },
    "openai": {
      "adapter_files": [
        "adapters/openai/AGENTS.md"
      ],
      "description": "Provider-neutral bundle for OpenAI/Codex-style agents that can consume repository instructions and Markdown skills."
    },
    "qwen": {
      "adapter_files": [
        "adapters/qwen/AGENTS.md"
      ],
      "description": "Provider-neutral Markdown bundle for Qwen-based coding agents."
    },
    "windsurf": {
      "adapter_files": [
        "adapters/windsurf/.windsurfrules"
      ],
      "description": "Provider-neutral Markdown bundle for Windsurf/Cascade rule adaptation."
    },
    "zed": {
      "adapter_files": [
        "adapters/zed/.rules/agtmls.md"
      ],
      "description": "Provider-neutral Markdown bundle for Zed agent rule adaptation."
    }
  },
  "native_agents": {
    "aider": {
      "agents_dir": ".aider/agents",
      "allowed_tools_semantics": "declaration",
      "commands_dir": ".aider/commands",
      "install_mode": "symlink",
      "prompt_file": "CONVENTIONS.md",
      "skills_dir": ".aider/skills",
      "approval_settings": [
        {
          "file": ".aider.conf.yml",
          "scope": "project",
          "format": "yaml",
          "key": "yes-always",
          "unattended": [
            true
          ]
        },
        {
          "file": "~/.aider.conf.yml",
          "scope": "user",
          "format": "yaml",
          "key": "yes-always",
          "unattended": [
            true
          ]
        }
      ],
      "user_skills_dirs": []
    },
    "antigravity": {
      "agents_dir": ".agents/agents",
      "allowed_tools_semantics": "declaration",
      "commands_dir": ".agents/commands",
      "install_mode": "symlink",
      "prompt_file": "AGENTS.md",
      "skills_dir": ".agents/skills",
      "approval_settings": [],
      "user_skills_dirs": []
    },
    "claude": {
      "agents_dir": ".claude/agents",
      "allowed_tools_semantics": "grant",
      "commands_dir": ".claude/commands",
      "install_mode": "symlink",
      "prompt_file": "CLAUDE.md",
      "skills_dir": ".claude/skills",
      "approval_settings": [
        {
          "file": ".claude/settings.local.json",
          "scope": "project (local)",
          "format": "json",
          "key": "permissions.defaultMode",
          "unattended": [
            "bypassPermissions",
            "dontAsk"
          ],
          "classified": [
            "auto"
          ]
        },
        {
          "file": ".claude/settings.json",
          "scope": "project",
          "format": "json",
          "key": "permissions.defaultMode",
          "unattended": [
            "bypassPermissions",
            "dontAsk"
          ],
          "classified": [
            "auto"
          ]
        },
        {
          "file": "~/.claude/settings.json",
          "scope": "user",
          "format": "json",
          "key": "permissions.defaultMode",
          "unattended": [
            "bypassPermissions",
            "dontAsk"
          ],
          "classified": [
            "auto"
          ]
        }
      ],
      "user_skills_dirs": [
        "~/.claude/skills"
      ],
      "live_probe": "claude-init"
    },
    "codex": {
      "agents_dir": ".codex/agents",
      "allowed_tools_semantics": "declaration",
      "commands_dir": ".codex/commands",
      "install_mode": "symlink",
      "prompt_file": "AGENTS.md",
      "skills_dir": ".codex/skills",
      "approval_settings": [
        {
          "file": ".codex/config.toml",
          "scope": "project",
          "format": "toml",
          "key": "approval_policy",
          "unattended": [
            "never"
          ]
        },
        {
          "file": ".codex/config.toml",
          "scope": "project",
          "format": "toml",
          "key": "sandbox_mode",
          "unattended": [
            "danger-full-access"
          ]
        },
        {
          "file": "~/.codex/config.toml",
          "scope": "user",
          "format": "toml",
          "key": "approval_policy",
          "unattended": [
            "never"
          ]
        },
        {
          "file": "~/.codex/config.toml",
          "scope": "user",
          "format": "toml",
          "key": "sandbox_mode",
          "unattended": [
            "danger-full-access"
          ]
        }
      ],
      "user_skills_dirs": [
        "~/.codex/skills"
      ],
      "live_probe": "codex-prompt-input"
    }
  },
  "plugin_targets": {
    "antigravity": {
      "description": "Google Antigravity CLI. Stages the directory it is given and reads plugin.json from that directory's root; it does not read .claude-plugin/.",
      "install": "agy plugin install https://github.com/sebastienrousseau/agtmls",
      "manifest_files": [
        "plugin.json"
      ]
    },
    "codex": {
      "description": "OpenAI Codex plugin system. Reads .codex-plugin/plugin.json, with marketplace metadata under .agents/plugins/.",
      "install": "/plugins -> search agtmls -> Install Plugin",
      "manifest_files": [
        ".agents/plugins/marketplace.json",
        ".codex-plugin/plugin.json"
      ]
    },
    "cursor": {
      "description": "Cursor plugin system. Reads .cursor-plugin/plugin.json; distinct from the .cursor/rules export target.",
      "install": "/add-plugin agtmls",
      "manifest_files": [
        ".cursor-plugin/plugin.json"
      ]
    },
    "gemini-cli": {
      "description": "Gemini CLI extensions. Reads gemini-extension.json and loads the named context file, which @-includes the router skill.",
      "install": "gemini extensions install https://github.com/sebastienrousseau/agtmls",
      "manifest_files": [
        "GEMINI.md",
        "gemini-extension.json"
      ]
    },
    "kimi": {
      "description": "Kimi Code plugin system. Reads .kimi-plugin/plugin.json and supports a session-start skill.",
      "install": "/plugins install https://github.com/sebastienrousseau/agtmls",
      "manifest_files": [
        ".kimi-plugin/plugin.json"
      ]
    },
    "opencode": {
      "description": "OpenCode. No skill-bundle manifest; consumes an instructions array in opencode.json, documented in .opencode/INSTALL.md.",
      "install": "see .opencode/INSTALL.md",
      "manifest_files": [
        ".opencode/INSTALL.md"
      ]
    }
  },
  "schema_version": 1
}
