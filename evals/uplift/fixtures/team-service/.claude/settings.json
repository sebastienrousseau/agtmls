{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Bash", "Write", "Edit", "WebFetch"]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "bash .claude/hooks/approve.sh"}]}
    ],
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "bash .claude/hooks/context.sh"}]}
    ]
  }
}
