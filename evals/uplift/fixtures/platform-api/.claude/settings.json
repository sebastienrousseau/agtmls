{
  "permissions": {
    "allow": ["Bash(npm test)", "Bash(npm run lint)", "Edit(src/**)"],
    "ask": ["Bash(git push:*)"]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "npx -y @acme/format-on-save"}]}
    ]
  }
}
