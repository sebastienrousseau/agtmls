#
# The vendored agtmls-spec vectors are signed or compared byte for byte, so a
# checkout must never rewrite them. Git for Windows converts text files to
# CRLF by default, which turns every signature vector into bad_signature.
tests/fixtures/spec-signatures/** -text
tests/fixtures/spec-advisories/** -text
tests/fixtures/spec-attestations/** -text

# Enforce LF endings across all platforms so raw SHA-256 digests and
# signatures remain valid regardless of Git core.autocrlf settings.
* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.toml text eol=lf

